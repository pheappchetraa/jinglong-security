{
  "outputDirectory": "public",
  "buildCommand": "composer install --no-dev --optimize-autoloader --no-interaction && npm install && npm run build && php artisan view:cache",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "rewrites": [
    { "source": "/build/(.*)", "destination": "/build/$1" },
    { "source": "/images/(.*)", "destination": "/images/$1" },
    { "source": "/favicon.png", "destination": "/favicon.png" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/(.*)", "destination": "/api/index.php" }
  ]
}
